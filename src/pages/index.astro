---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const vttUrl = 'https://foundryvtt.questwithwasem.com';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      :root {
        --ink: #ffffff;
        --purple: #7a2cff;
        --purple-hover: #8f4bff;
        --purple-shadow: rgba(122, 44, 255, 0.45);
      }

      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        color: var(--ink);
        font: 16px/1.6 ui-rounded, system-ui, -apple-system, 'Segoe UI', Roboto, Ubuntu, Cantarell, 'Noto Sans', sans-serif;
        background: #0b0f1a url('/Mountains.png') center/cover no-repeat fixed;
      }

      .wrap {
        position: relative;
        z-index: 1;
        display: flex;
        min-height: 100dvh;
        flex-direction: column;
      }

      main {
        flex: 1 1 auto;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
      }

      .vtt-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        text-align: center;
        background: var(--purple);
        color: #fff;
        border-radius: 1rem;
        font-size: clamp(1.25rem, 2.2vw, 2rem);
        font-weight: 800;
        padding: clamp(1rem, 2.2vw, 1.5rem) clamp(1.5rem, 4.4vw, 3.2rem);
        box-shadow: 0 20px 44px var(--purple-shadow);
        transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
      }

      .vtt-button:hover,
      .vtt-button:focus-visible {
        background: var(--purple-hover);
        transform: translateY(-2px) scale(1.01);
        box-shadow: 0 24px 52px rgba(143, 75, 255, 0.55);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <Header />

      <main>
        <a class="vtt-button" href={vttUrl} target="_blank" rel="noopener noreferrer">
          Open Virtual Tabletop
        </a>
      </main>

      <Footer />
    </div>
  </body>
</html>
